# Copy to backend/.env to override defaults for native (non-Docker) runs.
# When running via docker-compose, these are set directly in
# docker-compose.yml instead (container hostname "postgres", not "localhost").

QA_DATABASE_URL=postgresql+asyncpg://qa_user:qa_password@localhost:5433/payment_qa
QA_HOST=127.0.0.1
QA_PORT=8420
QA_LOG_LEVEL=INFO

# --- Concurrent-run backpressure ---
# How many runs may execute at once (see api/v1/runs.py's _run_semaphore).
# A run over this limit is still accepted immediately and stays "queued"
# until a slot frees -- nothing is rejected or dropped.
QA_MAX_CONCURRENT_RUNS=3

# --- Experimental cognition modules (off by default -- see
# CHANGELOG_COGNITIVE_UPGRADE.md: async_pipeline, hyperparameter_optimizer,
# multi_agent_ensemble and novel_discovery are not currently wired to
# anything; turning this on instantiates them without connecting them to
# anything either -- that's separate follow-up work) ---
QA_ENABLE_EXPERIMENTAL_COGNITION_MODULES=false

# --- Ambiguous-case resolution for the LLM-Ersatz-Layer ---
# Formerly an optional real-LLM escalation path (backend/benchmark/
# llm_escalation.py, removed -- see backend/benchmark/
# ambiguous_case_resolution.py's module docstring for why). Fully local
# now: no API key, no network call, no provider to configure. Defaults to
# enabled since there is no cost/privacy trade-off left to gate behind an
# opt-in.
QA_ENABLE_AMBIGUOUS_CASE_RESOLUTION=true
QA_AMBIGUOUS_RESOLUTION_MEMORY_CONTEXT_ITEMS=3

# --- Cognition knowledge-store retention ---
# Empty/unset = accumulate forever (unchanged default behavior). Set a
# number of seconds to bound episodic_memories/test_history growth for a
# target that gets tested continuously over months.
QA_EPISODIC_RETENTION_SECONDS=
QA_DEFAULT_TIMEOUT_SECONDS=30
QA_DEFAULT_USER_AGENT=PaymentQA-Suite/1.0

# --- Scope guard / request budget (testing/scope_guard.py) ---
# Applied at the single QAHttpClient choke point to EVERY request, retries and redirect hops included.
# A run may only tighten these per request (POST /runs), never lift them. The target host (and the entry
# page's host) is always in scope; extra hosts come from RunCreateRequest.extra_allowed_hosts.
QA_MAX_REQUESTS_PER_RUN=10000
QA_MAX_REQUESTS_PER_SECOND=25
# QA_RUN_DEADLINE_SECONDS=1800

# --- Local-only API guard (enterprise_controls/http_perimeter.py) ---
# Host + Origin checks are always on while the Enterprise Controls component is available (if it is not, the app logs a CRITICAL message and
# starts WITHOUT the guard: docs/ENTERPRISE_CONTROLS.md). An API token additionally closes the residual `Origin: null` gap.
QA_API_TOKEN=
QA_ALLOWED_HOSTNAMES=localhost,127.0.0.1,[::1],testserver
QA_EXTRA_ALLOWED_ORIGINS=
QA_STRICT_LOCAL_ORIGINS=false

# --- Payment-integrity Execution Brief (testing/integrity/brief.py) ---
# A plain file, chmod 600. PURE BLACK-BOX: it holds only customer-level information (approved hosts, synthetic identity aliases and the
# NAME of the env var that holds each identity's token, the customer-facing surface, public prices, protected features). Secrets, webhook
# signing keys, DB URLs, admin/staff credentials, internal URLs and hints are REJECTED by the purity gate -- never put them here.
QA_INTEGRITY_BRIEF_PATH=qa_integrity/brief.json
